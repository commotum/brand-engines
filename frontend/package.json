{
  "name": "vuca-app",
  "version": "1.0.0",
  "description": "Local interface for training and exploring GPT-2 brand engines",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--openssl-legacy-provider next dev --hostname 127.0.0.1 --port 3017",
    "test": "jest --runInBand && npm run tsc && npm run lint",
    "test:watch": "jest --watch",
    "tsc": "tsc",
    "build": "NODE_OPTIONS=--openssl-legacy-provider next build",
    "lint": "eslint --ext .ts,.tsx,.js,.jsx .",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "prettier"
  },
  "architect": "Jake",
  "devDependencies": {
    "@testing-library/jest-dom": "5.11.6",
    "@testing-library/react": "11.2.2",
    "@types/jest": "26.0.15",
    "@types/lodash.debounce": "^4.0.6",
    "@types/react": "17.0.0",
    "@types/react-dom": "17.0.0",
    "@types/react-modal": "^3.10.6",
    "@types/react-select": "^3.0.27",
    "@types/styled-components": "5.1.4",
    "@typescript-eslint/parser": "4.9.0",
    "babel-plugin-styled-components": "1.12.0",
    "eslint": "7.14.0",
    "eslint-config-prettier": "6.15.0",
    "eslint-plugin-import": "2.22.1",
    "eslint-plugin-prettier": "3.1.4",
    "eslint-plugin-react": "7.21.5",
    "fetch-mock": "^9.11.0",
    "jest": "26.6.3",
    "prettier": "2.2.1",
    "ts-jest": "26.4.4",
    "typescript": "4.1.2",
    "webpack": "4.44.2"
  },
  "dependencies": {
    "@types/uuid": "^8.3.0",
    "date-fns": "^2.16.1",
    "formik": "2.2.6",
    "lodash.debounce": "^4.0.8",
    "next": "10.0.0",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "react-modal": "^3.12.1",
    "react-select": "^3.1.1",
    "styled-components": "5.2.1",
    "swr": "^0.3.9",
    "uuid": "^8.3.2",
    "yup": "^0.32.8"
  }
}
